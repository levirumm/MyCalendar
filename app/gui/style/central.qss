/* Background Widgets */

QWidget[role="header_bar"] {{
    background-color: {blue[base]};
}}

QWidget[role="left_column"] {{
    background-color: {blue[light]};
}}

QWidget[role="day_bar"] {{
    background-color: {blue[dark]};
}}

CalendarCell {{
    background-color: white;
    border-right: 1px solid {blue[base]};
    border-bottom: 1px solid {blue[base]};
}}


/* Labels */

QLabel {{
    color: {gray[base]};
}}

QLabel[variant="white"] {{
    color: white;
}}

QLabel[variant="highlight"] {{
    color: white;
    background-color: {blue[darkest]};
    padding-bottom: 1px;
    padding-right: 1px;
}}


/* Button */

QPushButton {{
    color: {gray[base]};
}}

QPushButton[text_color="white"] {{
    color: white;
}}

QPushButton[role="drop_down"] {{
    text-align: left;
    border: none;
    border-radius: 6px;
    padding-left: 17px;
}}

/* Custom styling for form button */
QPushButton[color="lightest_blue"] {{
    background-color: {blue[lightest]};
}}

QPushButton[color="lightest_blue"]:hover {{
    background-color: {blue[light]};
}}

QPushButton[color="lightest_blue"]:pressed {{
    background-color: {blue[base]};
}}


/* Pop ups */

QFrame[role="menu"] {{
    background-color: white;
    border-radius: 5px;
}}