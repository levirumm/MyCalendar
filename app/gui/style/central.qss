/* Background Widgets */

QWidget[role="header_bar"] {{
    background-color: {base_blue};
}}

QWidget[role="left_column"] {{
    background-color: {light_blue};
}}

QWidget[role="day_bar"] {{
    background-color: {dark_blue};
}}

CalendarCell {{
    background-color: white;
    border-right: 1px solid {base_blue};
    border-bottom: 1px solid {base_blue};
}}


/* Labels */

QLabel {{
    color: {base_gray};
}}

QLabel[variant="white"] {{
    color: white;
}}

QLabel[variant="highlight"] {{
    color: white;
    background-color: {darkest_blue};
    padding-bottom: 1px;
}}


/* Button */

QPushButton {{
    color: {base_gray};
}}

QPushButton[text_color="white"] {{
    color: white;
}}

QPushButton[role="drop_down"] {{
    text-align: left;
    border: none;
    border-radius: 6px;
    padding-left: 17px;
}}

/* Custom styling for form button */
QPushButton[color="lightest_blue"] {{
    background-color: {lightest_blue};
}}

QPushButton[color="lightest_blue"]:hover {{
    background-color: {light_blue};
}}

QPushButton[color="lightest_blue"]:pressed {{
    background-color: {base_blue};
}}


/* Pop ups */

QFrame[role="menu"] {{
    background-color: white;
    border-radius: 10px;
}}